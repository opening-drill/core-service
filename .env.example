# ── Core service environment ──────────────────────────────────────────────
# Copy to `.env` and fill in. Validated on boot by src/config/env.ts.

# Runtime
NODE_ENV=development          # development | test | production
PORT=3000
LOG_LEVEL=info                # fatal | error | warn | info | debug | trace | silent

# Database (required from M2 onward) — credentials per doc/מדריכי התחברות לDB.pdf
# DATABASE_URL=postgresql://user:password@host:5432/dbname?schema=public

# Authentication / password hashing
PASSWORD_HASH_MODE=bcrypt      # bcrypt | plain (plain only for inherited plaintext data)
BCRYPT_ROUNDS=10

# API authentication — required on all `/api/*` routes (header `X-Api-Key`, min 16 chars)
# API_KEY=your-long-random-secret
# SIGNUP_DEFAULT_ROLE_NAME=viewer   # default role for POST /api/users/signup

# ── Object storage (picture upload/download) ──────────────────────────────
# Required only when using the Pictures upload/download endpoints.
#
# Google Cloud Storage (recommended on GCP) — uses Application Default Credentials:
#   Local:  gcloud auth application-default login
#   Cloud Run / GCE / GKE: runtime service account (no keys in env)
# GCS_BUCKET=your-bucket
# GCS_PROJECT_ID=your-gcp-project   # optional; inferred from ADC when omitted
# GCS_PRESIGN_EXPIRY_SECONDS=900
#
# S3 / MinIO fallback (when GCS_BUCKET is unset):
# S3_ENDPOINT=http://localhost:9000   # set for MinIO; omit for real AWS
# S3_REGION=us-east-1
# S3_BUCKET=pictures
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true            # MinIO needs path-style addressing
# S3_PRESIGN_EXPIRY_SECONDS=900
